    <DataSet Name="MerchantOptions">
      <Query>
        <DataSourceName>PaymentFlowDataSource</DataSourceName>
        <CommandText>SELECT
    MerchantId,
    MerchantLabel
FROM
(
    SELECT
        0 AS MerchantId,
        N'(All merchants)' AS MerchantLabel,
        0 AS SortOrder

    UNION ALL

    SELECT
        MerchantId,
        CONCAT(MerchantCode, N' - ', MerchantName) AS MerchantLabel,
        1 AS SortOrder
    FROM payment.Merchant
    WHERE IsActive = 1
) AS options
ORDER BY
    SortOrder,
    MerchantLabel;</CommandText>
      </Query>
      <Fields>
        <Field Name="MerchantId">
          <DataField>MerchantId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MerchantLabel">
          <DataField>MerchantLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CountryOptions">
      <Query>
        <DataSourceName>PaymentFlowDataSource</DataSourceName>
        <CommandText>SELECT
    CountryCode,
    CountryLabel
FROM
(
    SELECT
        CAST('*' AS varchar(2)) AS CountryCode,
        N'(All countries)' AS CountryLabel,
        0 AS SortOrder

    UNION ALL

    SELECT
        CONVERT(varchar(2), Merchant.CountryCode) AS CountryCode,
        CONVERT(nvarchar(10), Merchant.CountryCode) AS CountryLabel,
        1 AS SortOrder
    FROM payment.Merchant AS Merchant
    WHERE Merchant.IsActive = 1
    GROUP BY Merchant.CountryCode
) AS options
ORDER BY
    SortOrder,
    CountryLabel;</CommandText>
      </Query>
      <Fields>
        <Field Name="CountryCode">
          <DataField>CountryCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CountryLabel">
          <DataField>CountryLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CurrencyOptions">
      <Query>
        <DataSourceName>PaymentFlowDataSource</DataSourceName>
        <CommandText>SELECT
    CurrencyCode,
    CurrencyLabel
FROM
(
    SELECT
        CAST('*' AS varchar(3)) AS CurrencyCode,
        N'(All currencies)' AS CurrencyLabel,
        0 AS SortOrder

    UNION ALL

    SELECT
        CONVERT(varchar(3), CurrencyCode) AS CurrencyCode,
        CONCAT(CurrencyCode, N' - ', CurrencyName) AS CurrencyLabel,
        1 AS SortOrder
    FROM payment.Currency
    WHERE IsActive = 1
) AS options
ORDER BY
    SortOrder,
    CurrencyLabel;</CommandText>
      </Query>
      <Fields>
        <Field Name="CurrencyCode">
          <DataField>CurrencyCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CurrencyLabel">
          <DataField>CurrencyLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
